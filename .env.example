# এই ফাইলটা কপি করে .env নাম দাও, তারপর নিজের key বসাও:
#   cp .env.example .env
# Key পাবে: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key-here

# ---- নিচেরগুলো optional — না দিলে ডিফল্ট ভ্যালু ব্যবহার হবে ----

# LLM (উত্তর লেখার মডেল)। আরো ভালো (কিন্তু ধীর) উত্তরের জন্য: gemini-3.8-flash
# CHAT_MODEL=gemini-3.5-flash-lite

# Embedding মডেল — বদলালে অবশ্যই আবার ingest করতে হবে!
# EMBEDDING_MODEL=models/gemini-embedding-001

# Chunking — বদলালে আবার ingest করতে হবে
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200

# কয়টা চাঙ্ক retrieve হবে (API ডিফল্ট; UI তে slider দিয়েও বদলানো যায়)
# TOP_K=4

# একবারে কয়টা চাঙ্ক embedding API তে যাবে (429 rate limit আসলে কমাও)
# EMBED_BATCH_SIZE=50

# কোন হোস্ট ফোল্ডার থেকে ডকুমেন্ট নেবে (docker-compose এর জন্য)
# DOCS_PATH=./sample_docs
